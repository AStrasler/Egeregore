{
  // Egregore MCP server on Cloudflare Workers. Scaffold only: one `ping` tool.
  // Nothing here enables a public URL, a route, a custom domain, or a binding.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "egeregore",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Needed by `wrangler preview` in branch builds. Preview URLs stay off.
  "previews": {},
  "observability": { "enabled": false }
}
